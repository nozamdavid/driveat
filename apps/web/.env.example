# Designated invite-only Spaces alpha PDS. This is also the default when unset.
NEXT_PUBLIC_ATPROTO_ALPHA_PDS=https://spaces-alpha.host.bsky.network
# Enables narrow public-repo, blob, and personal-Space permissions. The authority
# must control and publish the generated experimental Lexicons.
# Enable only after the DNS record and all schemas have been published.
# NEXT_PUBLIC_ATGALLERY_NSID_AUTHORITY=am.noz.atgallery.alpha

# Optional: override handle resolution independently of the alpha PDS.
# NEXT_PUBLIC_ATPROTO_HANDLE_RESOLVER=https://bsky.social

# Leave unset for the http://127.0.0.1 loopback client. Set this to the public
# HTTPS client-metadata URL when testing a hosted or tunneled deployment.
# NEXT_PUBLIC_ATPROTO_OAUTH_CLIENT_ID=https://gallery.example/oauth-client-metadata.json

# Optional: set the public origin of the deployed Cloudflare Worker Media Gateway
# to proxy and batch private media and previews.
# NEXT_PUBLIC_ATGALLERY_MEDIA_GATEWAY_URL=https://atgallery-media-gateway.<account>.workers.dev
