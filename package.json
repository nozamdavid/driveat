{
  "name": "atgallery",
  "version": "0.0.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @atgallery/domain build && pnpm --filter @atgallery/lexicons build && pnpm --filter @atgallery/atproto build && pnpm --filter @atgallery/web dev",
    "dev:appview": "pnpm --filter @atgallery/appview dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm --filter @atgallery/web lint",
    "lexicons:materialize": "node --import tsx scripts/materialize-lexicons.ts am.noz.atgallery.alpha lexicons",
    "lexicons:publish": "node --import tsx packages/lexicons/scripts/publish.ts",
    "pretest": "pnpm --filter './packages/**' -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
